// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ============================================
// ENUMS
// ============================================

enum UserRole {
  ARTISAN
  PARTNER
  ADMIN
  SUPER_ADMIN
}

enum AccountStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  PENDING_VERIFICATION
  REJECTED
}

enum ApplicationStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  PENDING_INFORMATION
  APPROVED
  REJECTED
  EXPIRED
}

enum RequirementType {
  MANDATORY
  OPTIONAL
}

enum DocumentStatus {
  PENDING
  VERIFIED
  REJECTED
  EXPIRED
}

enum CourseDeliveryMode {
  ONLINE
  OFFLINE
  HYBRID
}

enum CourseStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
  SUSPENDED
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  VIEW
  APPROVE
  REJECT
  SUSPEND
  ACTIVATE
  LOGIN
  LOGOUT
  PASSWORD_CHANGE
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

// ============================================
// LOCATION MODELS
// ============================================

model State {
  id        Int      @id @default(autoincrement())
  name      String   @unique @db.VarChar(255)
  stateMap  String?  @map("state_map") @db.VarChar(255)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  
  artisans    ArtisanProfile[]
  localGovts  LocalGovernment[]
  
  @@map("states")
}

model LocalGovernment {
  id        Int      @id @default(autoincrement())
  stateId   Int      @map("state_id")
  name      String   @db.VarChar(255)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  
  state     State @relation(fields: [stateId], references: [id], onDelete: Cascade)
  artisans  ArtisanProfile[]
  
  @@index([stateId])
  @@map("local_governments")
}

// ============================================
// SERVICE & INDUSTRY MODELS
// ============================================

model Industries {
  id          Int       @id @default(autoincrement())
  name        String    @unique @db.VarChar(255)
  description String?   @db.Text
  status      Boolean   @default(true)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  
  services    Service[]
  partnerIndustries PartnerIndustry[]
  
  @@map("industries")
}

model Service {
  id              Int       @id @default(autoincrement())
  industryId      Int       @map("industry_id")
  name            String    @db.VarChar(255)
  image           String?   @db.VarChar(500)
  description     String?   @db.Text
  status          Boolean   @default(true)
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  
  industry        Industries         @relation(fields: [industryId], references: [id], onDelete: Cascade)
  requirements    Requirement[]
  artisanServices ArtisanService[]
  coursesAsPrimary Course[]         @relation("PrimaryService")
  applications    Application[]
  requirementUploads RequirementUpload[]
  partnerServices PartnerService[]
  courseServices  CourseService[]
  
  @@index([industryId])
  @@map("services")
}

model Requirement {
  id          Int       @id @default(autoincrement())
  serviceId   Int       @map("service_id")
  name        String    @db.VarChar(500)
  type        RequirementType @default(MANDATORY)
  status      Boolean   @default(true)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  
  service     Service            @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  uploads     RequirementUpload[]
  applications ApplicationRequirement[]
  
  @@index([serviceId])
  @@map("requirements")
}

// ============================================
// AUTHENTICATION MODELS
// ============================================

model User {
  id              String          @id @default(cuid())
  email           String          @unique
  phone           String          @unique
  passwordHash    String
  firstName       String
  lastName        String
  profilePicture  String?         @db.Text
  role            UserRole
  isActive        Boolean         @default(true)
  isEmailVerified Boolean         @default(false)
  isPhoneVerified Boolean         @default(false)
  lastLoginAt     DateTime?
  currentSessionId String?        @map("current_session_id")
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")
  
  artisanProfile        ArtisanProfile?
  partnerProfile        PartnerProfile?
  adminProfile          AdminProfile?
  certificatesIssued    Certificate[]        @relation("Issuer")
  certificatesHeld      Certificate[]        @relation("Holder")
  sessions              Session[]
  auditedActions        AuditLog[]           @relation("Actor")
  passwordResets        PasswordReset[]
  oAuthAccounts         OAuthAccount[]
  notifications         Notification[]
  deviceTokens          DeviceToken[]
  loginHistory          LoginHistory[]
  reviewedApplications  Application[]        @relation("ApplicationReviewer")
  verifiedRequirements  ApplicationRequirement[] @relation("RequirementVerifier")
  verifiedRequirementUploads RequirementUpload[] @relation("RequirementUploadVerifier")
  verifiedDocuments     Document[]           @relation("DocumentVerifier")
  revokedCertificates   Certificate[]        @relation("Revoker")
  artisanReferrals      Referral[]           @relation("ArtisanReferrals")
  enrollments           Enrollment[]
  courseReviews         CourseReview[]
  paymentTransactions   PaymentTransaction[]
  processedRefunds      Refund[]
  apiKeys               ApiKey[]
  documents             Document[]
  
  @@index([email])
  @@index([phone])
  @@index([role])
  @@map("users")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expiresAt    DateTime @map("expires_at")
  ipAddress    String?  @map("ip_address")
  userAgent    String?  @map("user_agent")
  isRevoked    Boolean  @default(false)
  revokedAt    DateTime?
  createdAt    DateTime @default(now()) @map("created_at")
  
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([sessionToken])
  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model PasswordReset {
  id         String   @id @default(cuid())
  userId     String   @map("user_id")
  token      String   @unique
  expiresAt  DateTime @map("expires_at")
  usedAt     DateTime?
  createdAt  DateTime @default(now()) @map("created_at")
  
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([token])
  @@index([expiresAt])
  @@map("password_resets")
}

model OAuthAccount {
  id            String   @id @default(cuid())
  userId        String   @map("user_id")
  provider      String
  providerId    String   @map("provider_id")
  accessToken   String?  @map("access_token")
  refreshToken  String?  @map("refresh_token")
  expiresAt     DateTime?
  createdAt     DateTime @default(now()) @map("created_at")
  
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@unique([provider, providerId])
  @@index([userId])
  @@index([provider, providerId])
  @@map("oauth_accounts")
}

model LoginHistory {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  location  String?
  success   Boolean  @default(true)
  failureReason String?
  createdAt DateTime @default(now()) @map("created_at")
  
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId])
  @@index([createdAt])
  @@map("login_history")
}

model DeviceToken {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  token     String   @unique
  deviceType String  @map("device_type")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId])
  @@index([token])
  @@map("device_tokens")
}

// ============================================
// USER PROFILES
// ============================================

model ArtisanProfile {
  id                String              @id @default(cuid())
  userId            String              @unique @map("user_id")
  gender            Gender?
  dateOfBirth       DateTime?           @map("date_of_birth")
  address           String?             @db.Text
  stateId           Int?                @map("state_id")
  localGovernmentId Int?                @map("local_gvt_id")
  workingAddress    String?             @map("working_address") @db.Text
  yearsOfExperience Int?                @default(0) @map("years_of_experience")
  bio               String?             @db.Text
  skills            Json?               // JSON array of skills
  verificationStatus VerificationStatus @default(PENDING) @map("verification_status")
  permitStatus      VerificationStatus @default(PENDING) @map("permit_status")
  approvalStatus    VerificationStatus @default(PENDING) @map("approval_status")
  completionScore   Int?                @default(0) @map("completion_score")
  isProfileComplete Boolean             @default(false) @map("is_profile_complete")
  sanaaId           Int?                @unique @map("sanaa_id")
  onDuty            Boolean             @default(false) @map("on_duty")
  createdAt         DateTime            @default(now()) @map("created_at")
  updatedAt         DateTime            @updatedAt @map("updated_at")
  
  user              User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  state             State?              @relation(fields: [stateId], references: [id])
  localGovernment   LocalGovernment?    @relation(fields: [localGovernmentId], references: [id])
  artisanServices   ArtisanService[]
  artisanApplications Application[]     @relation("ArtisanApplications")
  requirementUploads RequirementUpload[]
  
  @@index([userId])
  @@index([stateId])
  @@index([localGovernmentId])
  @@index([verificationStatus])
  @@map("artisan_profiles")
}

model ArtisanService {
  id          Int       @id @default(autoincrement())
  artisanId   String    @map("artisan_id")
  serviceId   Int       @map("service_id")
  experience  Int?      // Years of experience in this specific service
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  
  artisan     ArtisanProfile @relation(fields: [artisanId], references: [id], onDelete: Cascade)
  service     Service        @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  
  @@unique([artisanId, serviceId])
  @@index([artisanId])
  @@index([serviceId])
  @@map("artisan_services")
}

model PartnerProfile {
  id                  String          @id @default(cuid())
  userId              String          @unique @map("user_id")
  businessName        String          @map("business_name")
  registrationNumber  String          @unique @map("registration_number")
  taxId               String?         @unique @map("tax_id")
  businessEmail       String          @map("business_email")
  businessPhone       String          @map("business_phone")
  website             String?
  address             String          @db.Text
  city                String
  state               String
  country             String          @default("Nigeria")
  description         String?         @db.Text
  logoUrl             String?         @map("logo_url")
  accreditationDocUrl String?         @map("accreditation_doc_url")
  status              AccountStatus   @default(PENDING_VERIFICATION)
  rejectionReason     String?         @map("rejection_reason")
  approvedAt          DateTime?       @map("approved_at")
  approvedBy          String?         @map("approved_by")
  commissionRate      Decimal?        @default(10.0) @map("commission_rate")
  totalRevenue        Decimal?        @default(0) @map("total_revenue")
  createdAt           DateTime        @default(now()) @map("created_at")
  updatedAt           DateTime        @updatedAt @map("updated_at")
  
  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  courses      Course[]
  referrals    Referral[]
  commissions  Commission[]
  partnerServices PartnerService[]
  partnerIndustries PartnerIndustry[]
  
  @@index([userId])
  @@index([businessName])
  @@index([status])
  @@index([registrationNumber])
  @@map("partner_profiles")
}

model PartnerService {
  id        Int      @id @default(autoincrement())
  partnerId String   @map("partner_id")
  serviceId Int      @map("service_id")
  status    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  
  partner PartnerProfile @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  service Service        @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  
  @@unique([partnerId, serviceId])
  @@index([partnerId])
  @@index([serviceId])
  @@map("partner_services")
}

model PartnerIndustry {
  id         Int      @id @default(autoincrement())
  partnerId  String   @map("partner_id")
  industryId Int      @map("industry_id")
  createdAt  DateTime @default(now()) @map("created_at")
  
  partner PartnerProfile @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  industry Industries     @relation(fields: [industryId], references: [id], onDelete: Cascade)
  
  @@unique([partnerId, industryId])
  @@index([partnerId])
  @@index([industryId])
  @@map("partner_industries")
}

model AdminProfile {
  id               String   @id @default(cuid())
  userId           String   @unique @map("user_id")
  employeeId       String   @unique @map("employee_id")
  department       String
  position         String
  permissions      Json?
  lastActionAt     DateTime? @map("last_action_at")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")
  
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId])
  @@index([employeeId])
  @@map("admin_profiles")
}

// ============================================
// REQUIREMENT UPLOADS (Certification Documents)
// ============================================

model RequirementUpload {
  id            Int       @id @default(autoincrement())
  artisanId     String    @map("artisan_id")
  serviceId     Int       @map("service_id")
  requirementId Int       @map("requirement_id")
  documentUrl   String    @map("document_url") @db.VarChar(1000)
  publicId      String?   @map("public_id") @db.VarChar(500)
  status        DocumentStatus @default(PENDING)
  verifiedBy    String?   @map("verified_by")
  verifiedAt    DateTime? @map("verified_at")
  rejectionReason String? @map("rejection_reason")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  
  artisan     ArtisanProfile @relation(fields: [artisanId], references: [id], onDelete: Cascade)
  service     Service        @relation(fields: [serviceId], references: [id])
  requirement Requirement    @relation(fields: [requirementId], references: [id])
  verifier    User?          @relation("RequirementUploadVerifier", fields: [verifiedBy], references: [id])
  applicationRequirements ApplicationRequirement[]
  
  @@unique([artisanId, serviceId, requirementId])
  @@index([artisanId])
  @@index([serviceId])
  @@index([requirementId])
  @@index([status])
  @@map("requirement_uploads")
}

// ============================================
// COURSE & TRAINING (Enhanced for multiple services)
// ============================================

model Course {
  id               String            @id @default(cuid())
  partnerId        String            @map("partner_id")
  primaryServiceId Int               @map("primary_service_id")
  name             String
  code             String            @unique
  description      String            @db.Text
  syllabus         String?           @db.Text
  durationHours    Int               @map("duration_hours")
  durationDays     Int?              @map("duration_days")
  cost             Decimal           @db.Decimal(10, 2)
  currency         String            @default("NGN")
  deliveryMode     CourseDeliveryMode @map("delivery_mode")
  startDate        DateTime?         @map("start_date")
  endDate          DateTime?         @map("end_date")
  enrollmentDeadline DateTime?        @map("enrollment_deadline")
  maxStudents      Int?              @map("max_students")
  currentEnrollment Int              @default(0) @map("current_enrollment")
  thumbnailUrl     String?           @map("thumbnail_url")
  status           CourseStatus      @default(DRAFT)
  rating           Decimal?          @default(0) @db.Decimal(3, 2)
  reviewCount      Int               @default(0) @map("review_count")
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")
  
  partner         PartnerProfile @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  primaryService  Service        @relation("PrimaryService", fields: [primaryServiceId], references: [id])
  referrals       Referral[]
  enrollments     Enrollment[]
  reviews         CourseReview[]
  courseServices  CourseService[]
  
  @@index([partnerId])
  @@index([primaryServiceId])
  @@index([status])
  @@index([deliveryMode])
  @@index([code])
  @@map("courses")
}

model CourseService {
  id        Int      @id @default(autoincrement())
  courseId  String   @map("course_id")
  serviceId Int      @map("service_id")
  createdAt DateTime @default(now()) @map("created_at")
  
  course  Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  
  @@unique([courseId, serviceId])
  @@index([courseId])
  @@index([serviceId])
  @@map("course_services")
}

// ============================================
// APPLICATION & CERTIFICATION
// ============================================

model Application {
  id              String          @id @default(cuid())
  artisanId       String          @map("artisan_id")
  serviceId       Int             @map("service_id")
  applicationNumber String        @unique @map("application_number")
  status          ApplicationStatus @default(DRAFT)
  completionScore Int             @default(0) @map("completion_score")
  paymentStatus   PaymentStatus   @default(PENDING) @map("payment_status")
  paymentId       String?         @unique @map("payment_id")
  paymentAmount   Decimal?        @map("payment_amount") @db.Decimal(10, 2)
  paymentDate     DateTime?       @map("payment_date")
  reviewedBy      String?         @map("reviewed_by")
  reviewedAt      DateTime?       @map("reviewed_at")
  rejectionReason String?         @map("rejection_reason")
  submittedAt     DateTime?       @map("submitted_at")
  approvedAt      DateTime?       @map("approved_at")
  expiryDate      DateTime?       @map("expiry_date")
  notes           String?         @db.Text
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")
  
  artisan         ArtisanProfile  @relation("ArtisanApplications", fields: [artisanId], references: [id], onDelete: Cascade)
  service         Service         @relation(fields: [serviceId], references: [id])
  reviewer        User?           @relation("ApplicationReviewer", fields: [reviewedBy], references: [id])
  documents       Document[]
  applicationRequirements ApplicationRequirement[]
  certificate     Certificate?
  paymentTransaction PaymentTransaction?
  referrals       Referral[]
  
  @@index([artisanId])
  @@index([serviceId])
  @@index([status])
  @@index([applicationNumber])
  @@index([paymentStatus])
  @@map("applications")
}

model ApplicationRequirement {
  id              String          @id @default(cuid())
  applicationId   String          @map("application_id")
  requirementId   Int             @map("requirement_id")
  isMet           Boolean         @default(false) @map("is_met")
  uploadId        Int?            @map("upload_id")
  verifiedBy      String?         @map("verified_by")
  verifiedAt      DateTime?       @map("verified_at")
  rejectionReason String?         @map("rejection_reason")
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")
  
  application Application   @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  requirement Requirement   @relation(fields: [requirementId], references: [id])
  upload      RequirementUpload? @relation(fields: [uploadId], references: [id])
  verifier    User?         @relation("RequirementVerifier", fields: [verifiedBy], references: [id])
  documents   Document[]
  
  @@unique([applicationId, requirementId])
  @@index([applicationId])
  @@index([requirementId])
  @@index([uploadId])
  @@map("application_requirements")
}

model Document {
  id                       String            @id @default(cuid())
  applicationRequirementId String?           @map("application_requirement_id")
  applicationId            String?           @map("application_id")
  userId                   String            @map("user_id")
  originalName             String            @map("original_name")
  fileUrl                  String            @map("file_url")
  publicId                 String?           @map("public_id")
  fileHash                 String            @unique @map("file_hash")
  mimeType                 String            @map("mime_type")
  fileSize                 Int               @map("file_size")
  status                   DocumentStatus    @default(PENDING)
  verifiedBy               String?           @map("verified_by")
  verifiedAt               DateTime?         @map("verified_at")
  rejectionReason          String?           @map("rejection_reason")
  uploadedAt               DateTime          @default(now()) @map("uploaded_at")
  updatedAt                DateTime          @updatedAt @map("updated_at")
  
  applicationRequirement ApplicationRequirement? @relation(fields: [applicationRequirementId], references: [id])
  application           Application?            @relation(fields: [applicationId], references: [id])
  verifier              User?                   @relation("DocumentVerifier", fields: [verifiedBy], references: [id])
  user                  User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([applicationRequirementId])
  @@index([applicationId])
  @@index([userId])
  @@index([status])
  @@index([fileHash])
  @@map("documents")
}

// ============================================
// CERTIFICATION
// ============================================

model Certificate {
  id              String    @id @default(cuid())
  applicationId   String    @unique @map("application_id")
  artisanId       String    @map("artisan_id")
  issuedBy        String    @map("issued_by")
  certificateNumber String  @unique @map("certificate_number")
  uniqueCode      String    @unique @map("unique_code")
  qrHash          String    @unique @map("qr_hash")
  qrCodeUrl       String    @map("qr_code_url")
  blockchainHash  String?   @map("blockchain_hash")
  issuedAt        DateTime  @default(now()) @map("issued_at")
  expiresAt       DateTime? @map("expires_at")
  isRevoked       Boolean   @default(false) @map("is_revoked")
  revokedAt       DateTime? @map("revoked_at")
  revokedBy       String?   @map("revoked_by")
  revocationReason String?  @map("revocation_reason")
  downloadCount   Int       @default(0) @map("download_count")
  verifyCount     Int       @default(0) @map("verify_count")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  
  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  artisan     User        @relation("Holder", fields: [artisanId], references: [id])
  issuer      User        @relation("Issuer", fields: [issuedBy], references: [id])
  revoker     User?       @relation("Revoker", fields: [revokedBy], references: [id])
  verifications CertificateVerification[]
  
  @@index([artisanId])
  @@index([certificateNumber])
  @@index([uniqueCode])
  @@index([qrHash])
  @@index([isRevoked])
  @@map("certificates")
}

model CertificateVerification {
  id            String    @id @default(cuid())
  certificateId String    @map("certificate_id")
  verifiedBy    String?   @map("verified_by")
  ipAddress     String?   @map("ip_address")
  userAgent     String?   @map("user_agent")
  location      String?
  verifiedAt    DateTime  @default(now()) @map("verified_at")
  
  certificate Certificate @relation(fields: [certificateId], references: [id], onDelete: Cascade)
  
  @@index([certificateId])
  @@index([verifiedAt])
  @@map("certificate_verifications")
}

// ============================================
// REFERRAL & MATCHING
// ============================================

model Referral {
  id               String    @id @default(cuid())
  applicationId    String    @map("application_id")
  courseId         String    @map("course_id")
  partnerId        String    @map("partner_id")
  artisanId        String    @map("artisan_id")
  referralCode     String    @unique @map("referral_code")
  clickedAt        DateTime? @map("clicked_at")
  enrolledAt       DateTime? @map("enrolled_at")
  completedAt      DateTime? @map("completed_at")
  commissionAmount Decimal?  @map("commission_amount") @db.Decimal(10, 2)
  commissionPaid   Boolean   @default(false) @map("commission_paid")
  commissionPaidAt DateTime? @map("commission_paid_at")
  status           String    @default("PENDING")
  expiresAt        DateTime? @map("expires_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  
  application Application    @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  course      Course         @relation(fields: [courseId], references: [id])
  partner     PartnerProfile @relation(fields: [partnerId], references: [id])
  artisan     User           @relation("ArtisanReferrals", fields: [artisanId], references: [id])
  commission  Commission?
  
  @@index([applicationId])
  @@index([courseId])
  @@index([partnerId])
  @@index([artisanId])
  @@index([status])
  @@index([referralCode])
  @@map("referrals")
}

model Commission {
  id          String    @id @default(cuid())
  referralId  String    @unique @map("referral_id")
  partnerId   String    @map("partner_id")
  amount      Decimal   @db.Decimal(10, 2)
  rate        Decimal   @db.Decimal(5, 2)
  status      String    @default("PENDING")
  paidAt      DateTime? @map("paid_at")
  transactionId String? @map("transaction_id")
  notes       String?   @db.Text
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  
  referral Referral      @relation(fields: [referralId], references: [id], onDelete: Cascade)
  partner  PartnerProfile @relation(fields: [partnerId], references: [id])
  
  @@index([partnerId])
  @@index([status])
  @@map("commissions")
}

// ============================================
// COURSE ENROLLMENT & REVIEWS
// ============================================

model Enrollment {
  id          String    @id @default(cuid())
  courseId    String    @map("course_id")
  artisanId   String    @map("artisan_id")
  enrollmentCode String  @unique @map("enrollment_code")
  status      String    @default("ACTIVE")
  progress    Int       @default(0)
  completedAt DateTime? @map("completed_at")
  certificateIssued Boolean @default(false) @map("certificate_issued")
  paymentId   String?   @map("payment_id")
  amountPaid  Decimal?  @db.Decimal(10, 2) @map("amount_paid")
  enrolledAt  DateTime  @default(now()) @map("enrolled_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  
  course  Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  artisan User   @relation(fields: [artisanId], references: [id])
  review  CourseReview?
  
  @@unique([courseId, artisanId])
  @@index([courseId])
  @@index([artisanId])
  @@index([status])
  @@index([enrollmentCode])
  @@map("enrollments")
}

model CourseReview {
  id          String    @id @default(cuid())
  courseId    String    @map("course_id")
  artisanId   String    @map("artisan_id")
  enrollmentId String   @unique @map("enrollment_id")
  rating      Int
  title       String?
  comment     String?   @db.Text
  isVerified  Boolean   @default(true) @map("is_verified")
  helpfulCount Int      @default(0) @map("helpful_count")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  
  course     Course     @relation(fields: [courseId], references: [id], onDelete: Cascade)
  artisan    User       @relation(fields: [artisanId], references: [id])
  enrollment Enrollment @relation(fields: [enrollmentId], references: [id])
  
  @@index([courseId])
  @@index([artisanId])
  @@index([rating])
  @@map("course_reviews")
}

// ============================================
// PAYMENT & TRANSACTIONS
// ============================================

model PaymentTransaction {
  id               String       @id @default(cuid())
  applicationId    String?      @unique @map("application_id")
  userId           String       @map("user_id")
  transactionRef   String       @unique @map("transaction_ref")
  paymentGateway   String       @map("payment_gateway")
  amount           Decimal      @db.Decimal(10, 2)
  currency         String       @default("NGN")
  status           PaymentStatus @default(PENDING)
  gatewayResponse  Json?        @map("gateway_response")
  metadata         Json?
  paidAt           DateTime?    @map("paid_at")
  failureReason    String?      @map("failure_reason")
  webhookReceivedAt DateTime?    @map("webhook_received_at")
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")
  
  application Application? @relation(fields: [applicationId], references: [id])
  user        User         @relation(fields: [userId], references: [id])
  refunds     Refund[]
  
  @@index([applicationId])
  @@index([userId])
  @@index([transactionRef])
  @@index([status])
  @@index([createdAt])
  @@map("payment_transactions")
}

model Refund {
  id              String   @id @default(cuid())
  transactionId   String   @map("transaction_id")
  refundReference String   @unique @map("refund_reference")
  amount          Decimal  @db.Decimal(10, 2)
  reason          String
  status          String   @default("PENDING")
  gatewayResponse Json?    @map("gateway_response")
  processedBy     String   @map("processed_by")
  processedAt     DateTime? @map("processed_at")
  createdAt       DateTime @default(now()) @map("created_at")
  
  transaction PaymentTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  processor   User               @relation(fields: [processedBy], references: [id])
  
  @@index([transactionId])
  @@index([refundReference])
  @@index([status])
  @@map("refunds")
}

// ============================================
// NOTIFICATION SYSTEM
// ============================================

model Notification {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  type        String
  title       String
  content     String   @db.Text
  channel     String
  priority    String   @default("NORMAL")
  status      String   @default("PENDING")
  readAt      DateTime? @map("read_at")
  deliveredAt DateTime? @map("delivered_at")
  failedAt    DateTime? @map("failed_at")
  failureReason String? @map("failure_reason")
  metadata    Json?
  createdAt   DateTime @default(now()) @map("created_at")
  
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@map("notifications")
}

model NotificationTemplate {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  subject     String?
  body        String   @db.Text
  channel     String
  variables   Json?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  
  @@map("notification_templates")
}

// ============================================
// AUDIT & LOGGING
// ============================================

model AuditLog {
  id          String      @id @default(cuid())
  userId      String?     @map("user_id")
  action      AuditAction
  entityType  String      @map("entity_type")
  entityId    String      @map("entity_id")
  oldValues   Json?       @map("old_values")
  newValues   Json?       @map("new_values")
  ipAddress   String?     @map("ip_address")
  userAgent   String?     @map("user_agent")
  sessionId   String?     @map("session_id")
  requestId   String?     @map("request_id")
  createdAt   DateTime    @default(now()) @map("created_at")
  
  user User? @relation("Actor", fields: [userId], references: [id])
  
  @@index([userId])
  @@index([action])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@index([requestId])
  @@map("audit_logs")
}

// ============================================
// SYSTEM CONFIGURATION
// ============================================

model SystemSetting {
  id          String   @id @default(cuid())
  key         String   @unique
  value       Json
  type        String
  description String?  @db.Text
  category    String   @default("general")
  isPublic    Boolean  @default(false) @map("is_public")
  updatedBy   String?  @map("updated_by")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  
  @@index([key])
  @@index([category])
  @@map("system_settings")
}

model ApiKey {
  id          String   @id @default(cuid())
  name        String
  key         String   @unique
  hashedKey   String   @unique @map("hashed_key")
  userId      String   @map("user_id")
  permissions Json
  expiresAt   DateTime? @map("expires_at")
  lastUsedAt  DateTime? @map("last_used_at")
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")
  
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([key])
  @@index([userId])
  @@index([isActive])
  @@map("api_keys")
}